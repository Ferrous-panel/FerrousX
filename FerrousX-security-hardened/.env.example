# =============================================================================
# FERROUSX ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Sao chép tệp này sang .env hoặc truyền qua systemd EnvironmentFile.
# Không lưu trữ bất kỳ khóa bí mật thật nào trong mã nguồn (Repository).
# =============================================================================

# Đường dẫn tệp cấu hình chính của FerrousX
FERROUSX_CONFIG="/etc/ferrousx/ferrousx.toml"

# Đường dẫn tệp lưu trữ Admin Token 256-bit (quyền 0600, tự động sinh từ /dev/urandom nếu chưa có)
FERROUSX_ADMIN_TOKEN_FILE="/etc/ferrousx/admin.token"

# Mức độ ghi nhật ký (error | warn | info | debug)
RUST_LOG="ferrousx=info"

# Cổng giao diện mô phỏng/quản trị Web cục bộ
PORT=3000
