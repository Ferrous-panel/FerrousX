[Unit]
Description=FerrousX Native Rust Web Server & Reverse Proxy (io_uring + TLS 1.3 + HTTP/3 QUIC + WAF)
Documentation=https://github.com/Ferrous-panel/FerrousX
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=all
User=ferrousx
Group=ferrousx

# Cho phép bind cổng đặc quyền (< 1024: 80, 443), ghim CPU/NUMA và nạp eBPF/XDP
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_RESOURCE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_RESOURCE

# Tự động khởi tạo thư mục runtime /run/ferrousx với quyền 0750
RuntimeDirectory=ferrousx
RuntimeDirectoryMode=0750
StateDirectory=ferrousx
StateDirectoryMode=0750
LogsDirectory=ferrousx
LogsDirectoryMode=0750

# Giới hạn tài nguyên cấp độ Production cho kết nối đồng thời lớn (C10M)
LimitNOFILE=1048576
LimitNPROC=65536
LimitMEMLOCK=infinity
TasksMax=infinity
OOMScoreAdjust=-500

# Kiểm tra cú pháp cấu hình trước khi khởi chạy hoặc nạp lại (tương thích Ferrous-Panel v2.5.0)
ExecStartPre=/usr/local/bin/ferrousx-bin --check-config --config /etc/ferrousx/ferrousx.toml
ExecStart=/usr/local/bin/ferrousx-bin --config /etc/ferrousx/ferrousx.toml
ExecReload=/usr/local/bin/ferrousx-bin --check-config --config /etc/ferrousx/ferrousx.toml
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillMode=mixed
KillSignal=SIGTERM

# Gia cố bảo mật Systemd (Sandboxing & Hardening)
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/ferrousx /var/log/ferrousx /var/cache/ferrousx /run/ferrousx /www
ReadOnlyPaths=/etc/ferrous-panel
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
UMask=0027

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ferrousx

[Install]
WantedBy=multi-user.target
