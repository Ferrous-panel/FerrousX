[Unit]
Description=FerrousX Pure-Rust HTTP/TLS/QUIC Web Server & Reverse Proxy
After=network.target network-online.target
Wants=network-online.target
Documentation=https://github.com/Ferrous-panel/FerrousX
StartLimitIntervalSec=0

[Service]
Type=notify
WorkingDirectory=/etc/ferrousx
Environment=RUST_LOG=info
Environment=FERROUSX_CONFIG=/etc/ferrousx/ferrousx.toml
ExecStartPre=/usr/local/bin/ferrousx-bin --config /etc/ferrousx/ferrousx.toml --check-config
ExecStart=/usr/local/bin/ferrousx-bin --config /etc/ferrousx/ferrousx.toml
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=3s
OOMScoreAdjust=-1000

# Tối ưu hóa giới hạn File Descriptor và Bộ nhớ Khóa cho io_uring
LimitNOFILE=2097152
LimitMEMLOCK=infinity
LimitNPROC=512000

# Đặc quyền Linux Kernel tối thiểu (Principle of Least Privilege)
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_BPF CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_BPF CAP_NET_ADMIN
NoNewPrivileges=true

# Bảo vệ Hệ Thống & Cô Lập File System (Enterprise Sandboxing)
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
LockPersonality=true
SystemCallArchitectures=native

# Các đường dẫn được phép đọc/ghi (Logging, Run-time sockets, Sites TOML, ACME & Fallback SSL)
ReadWritePaths=/var/log/ferrousx /run/ferrousx /etc/ferrousx /etc/ferrousx/sites /etc/ferrousx/ssl /www/acme /www/wwwroot /etc/letsencrypt

[Install]
WantedBy=multi-user.target
