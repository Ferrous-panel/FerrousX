[Unit]
Description=FerrousPanel phpMyAdmin Internal Loopback Service (127.0.0.1:888)
Documentation=https://github.com/Ferrous-panel/FerrousX
After=network.target mariadb.service mysql.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/usr/share/phpmyadmin
Environment="PHP_CLI_SERVER_WORKERS=4"

# Cho phép user www-data (non-root) bind cổng < 1024 (127.0.0.1:888) mà không bao giờ nâng quyền lên root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Bắt buộc chỉ lắng nghe trên Loopback 127.0.0.1:888 (chỉ truy cập qua FerrousX Reverse Proxy /phpadmin/)
ExecStart=/usr/bin/php -S 127.0.0.1:888 -t /usr/share/phpmyadmin /etc/ferrousx/pma-router.php
Restart=always
RestartSec=2

# Systemd Sandboxing & Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/phpmyadmin /tmp /var/tmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ferrous-pma

[Install]
WantedBy=multi-user.target
