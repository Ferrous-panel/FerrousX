# =============================================================================
# FERROUSX RUNTIME ENVIRONMENT TEMPLATE (conf/ferrousx.env.example)
# Hệ thống install.sh & repair.sh tự động khởi tạo /etc/ferrousx/ferrousx.env
# và /etc/profile.d/ferrousx.sh khi cài đặt trên VPS Linux.
# Thứ tự ưu tiên: Process ENV > $FERROUSX_ENV_FILE > ./.env > /etc/ferrousx/ferrousx.env > ferrousx.toml
# KHÔNG lưu trữ bất kỳ khóa bí mật (secret/token) thật nào trong mã nguồn.
# =============================================================================

# Đường dẫn tệp cấu hình chính và tệp biến môi trường của FerrousX
FERROUSX_CONFIG="/etc/ferrousx/ferrousx.toml"
FERROUSX_ENV_FILE="/etc/ferrousx/ferrousx.env"
FERROUSX_SITES_DIR="/etc/ferrousx/sites"
FERROUSX_ACME_WEBROOT="/www/acme"

# Điều khiển quản trị cục bộ (Unix Domain Socket + 256-bit Admin Token 0600)
FERROUSX_CONTROL_SOCKET="/run/ferrousx/panel-admin.sock"
FERROUSX_ADMIN_TOKEN_FILE="/etc/ferrousx/admin.token"

# Địa chỉ lắng nghe mạng (Triple-Stack TCP HTTP :80 + TLS :443 + UDP QUIC :443)
FERROUSX_BIND_HTTP="0.0.0.0:80"
FERROUSX_BIND_HTTPS="0.0.0.0:443"
FERROUSX_BIND_UDP="0.0.0.0:443"

# Số luồng Worker Thread-Per-Core (0 = tự động phát hiện theo số lõi CPU vật lý)
FERROUSX_WORKERS="0"

# Giao thức & Bảo mật
FERROUSX_ENABLE_HTTP3="true"
FERROUSX_WAF_MODE="block"
FERROUSX_SERVER_TOKENS="false"
FERROUSX_ENABLE_DYNAMIC_WWWROOT="false"

# Chứng chỉ TLS fallback (tự động sinh bằng rcgen/openssl nếu chưa tồn tại)
FERROUSX_TLS_CERT="/etc/ferrousx/ssl/fullchain.pem"
FERROUSX_TLS_KEY="/etc/ferrousx/ssl/privkey.pem"

# Giao diện quản trị Rust nhúng (chỉ lắng nghe trên Loopback 127.0.0.1)
FERROUSX_ENABLE_DASHBOARD="true"
FERROUSX_DASHBOARD_ADDR="127.0.0.1:9090"

# Reverse Proxy phpMyAdmin nội bộ (Loopback 127.0.0.1:888)
FERROUSX_ENABLE_PHPMYADMIN="true"
FERROUSX_PHPMYADMIN_UPSTREAM="127.0.0.1:888"

# Đồng bộ tự động với Ferrous-Panel v2.5.0
FERROUSX_PANEL_ENV="/etc/ferrous-panel/panel.env"
FERROUSX_PANEL_ADMIN_JSON="/etc/ferrous-panel/admin.json"

# Mức độ ghi nhật ký (error | warn | info | debug | trace)
RUST_LOG="ferrousx=info"
